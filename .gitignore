node_modules/
.expo/
dist/
ios/
android/

# signing keys — NEVER commit. Android signing keys are permanent once Play
# binds them; a leaked one cannot be rotated after the first upload.
*.jks
*.keystore

# Firebase service-account / admin keys — NEVER commit
*-firebase-adminsdk-*.json
google-services.json

# secrets
.env
.dev.vars*
!.dev.vars.example
!.env.example

# build artifacts
*.apk
*.aab

# wrangler
.wrangler/

# npm lockfile — this project uses pnpm. EAS Build infers the package manager
# from the lockfile, so two of them let the cloud build resolve a different
# dependency tree than the local one.
package-lock.json
